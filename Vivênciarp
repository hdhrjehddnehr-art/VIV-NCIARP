local velAtual = Vector3.zero
local flyAttachment, flyLinear
local flyDescendo = false

local function montarFly(root)
    if flyLinear and flyLinear.Parent then return end
    flyAttachment = Instance.new("Attachment")
    flyAttachment.Parent = root
    flyLinear = Instance.new("LinearVelocity")
    flyLinear.Attachment0 = flyAttachment
    flyLinear.MaxForce = 4e5
    flyLinear.RelativeTo = Enum.ActuatorRelativeTo.World
    flyLinear.VectorVelocity = Vector3.zero
    flyLinear.Parent = root
end

local function desmontarFly()
    if flyLinear then flyLinear:Destroy() flyLinear = nil end
    if flyAttachment then flyAttachment:Destroy() flyAttachment = nil end
    velAtual = Vector3.zero
end

UserInputService.InputBegan:Connect(function(input, gpe)
    if input.KeyCode == Enum.KeyCode.LeftControl then flyDescendo = true end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.LeftControl then flyDescendo = false end
end)

RunService.RenderStepped:Connect(function(dt)
    pcall(function()
        local root = getRoot(LP)
        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if not root or not hum then return end

        if flyAtivo then
            montarFly(root)

            if hum.FloorMaterial == Enum.Material.Air then
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end
            hum.AutoRotate = true

            local moveDir = hum.MoveDirection
            local alvoVel = Vector3.zero

            if moveDir.Magnitude > 0 then
                local v = Camera.CFrame:VectorToWorldSpace(moveDir)
                local horiz = Vector3.new(v.X, 0, v.Z)
                if horiz.Magnitude > 0 then
                    alvoVel = horiz.Unit * flyVelocidade
                end
            end

            if hum.Jump then
                alvoVel = alvoVel + Vector3.new(0, flyVelocidade * 0.5, 0)
            end
            if flyDescendo then
                alvoVel = alvoVel - Vector3.new(0, flyVelocidade * 0.5, 0)
            end

            if alvoVel.Magnitude < 1 and velAtual.Y > -flyVelocidade * 0.25 then
                alvoVel = alvoVel - Vector3.new(0, flyVelocidade * 0.25, 0)
            end

            velAtual = velAtual:Lerp(alvoVel, math.clamp(flySuav * dt * 60, 0, 1))

            local ray = workspace:Raycast(root.Position, Vector3.new(0, -5, 0))
            if ray and velAtual.Y < -flyVelocidade * 0.4 then
                velAtual = Vector3.new(velAtual.X, velAtual.Y * 0.35, velAtual.Z)
            end

            flyLinear.VectorVelocity = velAtual
        else
            desmontarFly()
        end
    end)
end)

