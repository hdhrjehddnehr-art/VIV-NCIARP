local lblListaTP = TabB:CreateParagraph({ Title = "Players", Content = "carregando..." })
local posicaoSalva = nil

local function tpProPlayer(pl)
    local meuRoot = getRoot(LP)
    local alvoRoot = getRoot(pl)
    if not (meuRoot and alvoRoot) then
        Rayfield:Notify({ Title = "TP", Content = "Sem personagem (você ou ele)!", Duration = 2 })
        return
    end
    posicaoSalva = meuRoot.CFrame -- salva onde você estava
    meuRoot.CFrame = alvoRoot.CFrame * CFrame.new(0, 0, 3)
    meuRoot.AssemblyLinearVelocity = Vector3.zero
    Rayfield:Notify({ Title = "TP", Content = "Teleportado até " .. pl.Name .. " — toque no ↩ pra voltar!", Duration = 3 })
end

local function voltarPosicao()
    local meuRoot = getRoot(LP)
    if not posicaoSalva then
        Rayfield:Notify({ Title = "TP", Content = "Nenhuma posição salva ainda.", Duration = 2 })
        return
    end
    if not meuRoot then return end
    meuRoot.CFrame = posicaoSalva
    meuRoot.AssemblyLinearVelocity = Vector3.zero
    Rayfield:Notify({ Title = "TP", Content = "Voltou pra posição salva!", Duration = 2 })
end

