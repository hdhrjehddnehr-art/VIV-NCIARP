local function centroTela()
    local vp = Camera.ViewportSize
    return Vector2.new(vp.X / 2, vp.Y / 2)
end

local function pegarAlvo()
    local centro = centroTela()
    local melhor, menorDist = nil, fovRaio
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LP and pl.Character then
            local hum = pl.Character:FindFirstChildOfClass("Humanoid")
            local head = pl.Character:FindFirstChild("Head")
            if hum and hum.Health > 0 and head then
                local pos, visivel = Camera:WorldToViewportPoint(head.Position)
                if visivel then
                    local dist = (Vector2.new(pos.X, pos.Y) - centro).Magnitude
                    if dist < menorDist then
                        menorDist = dist
                        melhor = head
                    end
                end
            end
        end
    end
    return melhor
end

