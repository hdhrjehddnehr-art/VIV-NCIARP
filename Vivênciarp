local meuHitboxChao = nil

local function aplicarInvisibilidade(chr, ativo)
    pcall(function()
        for _, p in ipairs(chr:GetDescendants()) do
            if p:IsA("BasePart") or p:IsA("Decal") then
                if ativo then
                    p.Transparency = 1
                    if p:IsA("BasePart") then p.Material = Enum.Material.SmoothPlastic end
                else
                    if p.Name ~= "HumanoidRootPart" then p.Transparency = 0 end
                end
            end
        end
    end)
end

