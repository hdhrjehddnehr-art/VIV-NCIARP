local function limparESP(pl)
    if pl.Character then
        local h = pl.Character:FindFirstChild("VIV_ESP")
        if h then h:Destroy() end
        local tag = pl.Character:FindFirstChild("VIV_ESP_TAG")
        if tag then tag:Destroy() end
    end
end

local function aplicarTag(chr, pl)
    local head = chr:FindFirstChild("Head")
    if not head then return end

    local tag = chr:FindFirstChild("VIV_ESP_TAG")
    if not espNomeAtivo or esconderVisual or not espAtivoTemp or not espAtivo then
        if tag then tag:Destroy() end
        return
    end

    if not tag then
        tag = Instance.new("BillboardGui")
        tag.Name = "VIV_ESP_TAG"
        tag.Adornee = head
        tag.Size = UDim2.new(0, 200, 0, 60)
        tag.StudsOffset = Vector3.new(0, 3.2, 0)
        tag.AlwaysOnTop = true
        tag.MaxDistance = 2000
        tag.Parent = chr

        local nome = Instance.new("TextLabel")
        nome.Name = "Nome"
        nome.Size = UDim2.new(1, 0, 0, 22)
        nome.BackgroundTransparency = 1
        nome.TextColor3 = Color3.fromRGB(255, 255, 255)
        nome.Font = Enum.Font.GothamBold
        nome.TextSize = 14
        nome.TextStrokeTransparency = 0.3
        nome.TextStrokeColor3 = Color3.new(0, 0, 0)
        nome.Text = pl.DisplayName .. " (@" .. pl.Name .. ")"
        nome.Parent = tag

        local info = Instance.new("TextLabel")
        info.Name = "Info"
        info.Size = UDim2.new(1, 0, 0, 16)
        info.Position = UDim2.new(0, 0, 0, 24)
        info.BackgroundTransparency = 1
        info.TextColor3 = Color3.fromRGB(120, 255, 120)
        info.Font = Enum.Font.Gotham
        info.TextSize = 12
        info.TextStrokeTransparency = 0.3
        info.Parent = tag
    end

    local meuRoot = getRoot(LP)
    local root = chr:FindFirstChild("HumanoidRootPart")
    local hum = chr:FindFirstChildOfClass("Humanoid")
    local infoLbl = tag:FindFirstChild("Info")
    if infoLbl and espInfoAtivo then
        local dist = (meuRoot and root) and math.floor((root.Position - meuRoot.Position).Magnitude) or 0
        local vida = hum and math.floor((hum.Health / math.max(hum.MaxHealth, 1)) * 100) or 0
        infoLbl.Text = dist .. "m • " .. vida .. "% ❤"
        infoLbl.Visible = true
    elseif infoLbl then
        infoLbl.Visible = false
    end
end

local function aplicarESP(pl)
    if esconderVisual or not espAtivoTemp then
        limparESP(pl)
        return
    end
    if pl == LP or not pl.Character then return end
    local chr = pl.Character
    local root = chr:FindFirstChild("HumanoidRootPart")

    if espAtivo and root then
        local hl = chr:FindFirstChild("VIV_ESP")
        if not hl then
            hl = Instance.new("Highlight")
            hl.Name = "VIV_ESP"
            hl.FillColor = Color3.fromRGB(255, 0, 0)
            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
            hl.FillTransparency = 0.5
            hl.Parent = chr
        end
        hl.DepthMode = espVerAtraves
            and Enum.HighlightDepthMode.AlwaysOnTop
            or Enum.HighlightDepthMode.Occluded
    else
        limparESP(pl)
    end

    pcall(function() aplicarTag(chr, pl) end)
end

